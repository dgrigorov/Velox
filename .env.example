# ─── massive.com ─────────────────────────────────────────────────────────────
MASSIVE_API_KEY=
MASSIVE_WS_URL=wss://socket.massive.com   # verify on massive.com/docs

# ─── Financial Modeling Prep ──────────────────────────────────────────────────
FMP_API_KEY=

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─── Unkey — API key management ───────────────────────────────────────────────
# Create account at unkey.com → create API → copy Root Key + API ID
UNKEY_ROOT_KEY=
UNKEY_API_ID=

# ─── Redis (Upstash for MVP, self-hosted for production) ──────────────────────
REDIS_URL=redis://localhost:6379
# Upstash: rediss://default:<password>@<host>.upstash.io:6380

# ─── Optional: Supabase (developer portal DB) ─────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ─── App ──────────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
